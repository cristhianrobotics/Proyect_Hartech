<?xml version="1.0"?>
<robot name="hartech_with_tool" xmlns:xacro="http://www.ros.org/wiki/xacro">
 <xacro:arg name="tool" default="parallel"/>
 <xacro:arg name="parameters_file" default="$(find robot_description)/config/robot_parameters.yaml"/>
 <xacro:arg name="simulation_file" default="$(find robot_description)/config/gazebo_simulation.yaml"/>
 <xacro:arg name="controllers_file" default="$(find hartech_tools)/config/controllers.yaml"/>
 <xacro:include filename="$(find robot_description)/urdf/robot_6dof.urdf.xacro"/>
 <xacro:include filename="parallel_gripper.xacro"/>
 <xacro:if value="${'$(arg tool)' == 'parallel'}"><xacro:hartech_parallel parent="tool0" gazebo="false"/></xacro:if>
</robot>
