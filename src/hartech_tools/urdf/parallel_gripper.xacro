<joint name="hartech_left_finger_joint" type="prismatic"><parent link="hartech_gripper_base"/><child link="hartech_left_finger"/><axis xyz="0 1 0"/><limit lower="0" upper="0.025" effort="20" velocity="0.025"/><dynamics damping="0.1" friction="0"/>
</joint>
<joint name="hartech_right_finger_joint" type="prismatic"><parent link="hartech_gripper_base"/><child link="hartech_right_finger"/><axis xyz="0 -1 0"/><limit lower="0" upper="0.025" effort="20" velocity="0.025"/><dynamics damping="0.1" friction="0"/>
<mimic joint="hartech_left_finger_joint" multiplier="1" offset="0"/>
</joint>
<joint name="hartech_rotor_joint" type="revolute"><parent link="hartech_gripper_base"/><child link="hartech_rotor"/><axis xyz="1 0 0"/><limit lower="-2.5" upper="0" effort="0.2" velocity="2.5"/><mimic joint="hartech_left_finger_joint" multiplier="-100" offset="0"/><dynamics damping="0.001"/></joint>
<link name="hartech_tcp"/><joint name="hartech_tcp_joint" type="fixed"><parent link="hartech_gripper_base"/><child link="hartech_tcp"/><origin xyz="0.1 0 0" rpy="0 1.5707963267948966 0"/></joint>
<xacro:if value="${gazebo}"><ros2_control name="HartechGripperSystem" type="system"><hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
<joint name="hartech_left_finger_joint">
<command_interface name="position"/><state_interface name="position"><param name="initial_value">0.015</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
<joint name="hartech_right_finger_joint">
<param name="mimic">hartech_left_finger_joint</param><param name="multiplier">1</param>
<command_interface name="position"/><state_interface name="position"><param name="initial_value">0.015</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
<joint name="hartech_rotor_joint">
<param name="mimic">hartech_left_finger_joint</param><param name="multiplier">-100</param>
<command_interface name="position"/><state_interface name="position"><param name="initial_value">-1.5</param></state_interface><state_interface name="velocity"/><state_interface name="effort"/></joint>
</ros2_control></xacro:if></xacro:macro></robot>